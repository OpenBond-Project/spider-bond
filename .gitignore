# ---------------------------------------------------------------- 密钥与私密配置
# 本地环境配置：含服务器地址等基础设施信息，绝不入库
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ---------------------------------------------------------------- 数据与运行时产物
# SQLite 数据库：存着真实用户的 GitHub ID、头像、学习记录
*.db
*.sqlite
*.sqlite3

# 构建产物与部署包（由 build.py 生成，体积大且可再生）
dist/
web/dist/
server/dist/
*.tar.gz
*.zip
!pyodide-lock.json

# ---------------------------------------------------------------- 依赖与缓存
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- 临时文件与日志
*.log
*.tmp
logo_render_tmp.png
bonds-logo-raw.svg
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 编辑器
.vscode/
.idea/
*.swp
*~

# ---------------------------------------------------------------- 工具目录
.workbuddy/

